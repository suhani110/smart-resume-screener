# Copy this file to .env and fill in your own values.
# If ANTHROPIC_API_KEY is left empty, the app automatically falls back
# to a local mock scorer (see app/services/llm_service.py) so the app
# still runs end-to-end without any paid API access.

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
DATABASE_URL=sqlite:///./resume_screener.db
